# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://micelio:micelio@localhost:5432/micelio?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Pesos máximos de subida, en MB. Suben sin tocar código: cambiar y reiniciar.
# No hay límite de duración para audio/video; el peso es el único tope (ver docs/PRODUCT.md).
UPLOAD_MAX_IMAGE_MB=15
UPLOAD_MAX_VIDEO_MB=250
UPLOAD_MAX_TEXT_MB=5
UPLOAD_MAX_AVATAR_MB=5

# S3 (Amazon S3 in production, MinIO locally via docker-compose)
# In AWS, leave AWS_S3_ENDPOINT unset and AWS_S3_FORCE_PATH_STYLE=false.
AWS_REGION=us-east-1
AWS_S3_BUCKET=micelio-files
AWS_ACCESS_KEY_ID=micelio
AWS_SECRET_ACCESS_KEY=micelio12345
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_SIGNED_URL_EXPIRES_IN=300
