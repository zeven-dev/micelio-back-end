generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  TEXT
}

enum Role {
  USER
  TEACHER
  ADMIN
  SUPPORT
}

/// Presentación del feed propio: cuadrícula de celdas 1:1 o masonry por relación de aspecto.
enum FeedLayout {
  GRID
  MASONRY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  cedula       String   @unique
  username     String   @unique
  role         Role     @default(USER)
  bio          String?
  avatarKey    String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Ajustes de presentación del feed propio (Fase 2). Viven en `User` y no en una tabla 1–1
  // porque siempre se leen junto al perfil (`UserPublic.feedSettings`) y nunca por separado.
  feedLayout  FeedLayout @default(GRID)
  feedColumns Int        @default(3)
  feedGap     Int        @default(2)

  folders   Folder[]
  posts     Post[]
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  @@map("users")
}

/// Grafo social: A sigue a B, y opcionalmente lo marca como favorito (prioridad en su home).
model Follow {
  id         String   @id @default(uuid())
  followerId String
  followedId String
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followers", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  // Los seguidos de alguien (con sus favoritos) y los seguidores de alguien son las dos
  // lecturas del grafo: el único compuesto cubre la primera, este índice la segunda.
  @@index([followedId])
  @@map("follows")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  userId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?     @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[]    @relation("FolderChildren")
  files    FileAsset[]

  // Unicidad del nombre entre hermanos. En Postgres los NULL son distintos entre sí, así que
  // este índice NO cubre las carpetas raíz (`parentId IS NULL`): para esas, la migración crea
  // el índice parcial `folders_userId_name_root_key`. `FoldersService` valida antes en ambos
  // casos para responder 409 en vez de un error crudo de Prisma.
  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([userId, parentId])
  @@map("folders")
}

model FileAsset {
  id           String   @id @default(uuid())
  folderId     String
  originalName String
  key          String   @unique
  mimeType     String
  type         FileType
  size         Int
  // Dimensiones en píxeles, declaradas por el cliente al confirmar la subida (el binario nunca
  // pasa por el backend, así que nadie más las conoce). Nulas en audio, texto y en los archivos
  // subidos antes de la Fase 2. Las publicaciones las heredan para el masonry.
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  folder Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  posts  PostMedia[]

  @@index([folderId])
  @@map("file_assets")
}

model Post {
  id          String   @id @default(uuid())
  authorId    String
  description String?
  tags        String[]
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media  PostMedia[]

  // El feed propio se lee siempre por autor y en el orden que él curó (`position` asc).
  @@index([authorId, position])
  // Búsqueda por etiquetas (Fase 9) y afinidad por temas (Fase 5) sobre el arreglo `tags`.
  @@index([tags(ops: ArrayOps)], type: Gin)
  @@map("posts")
}

model PostMedia {
  id          String @id @default(uuid())
  postId      String
  fileAssetId String
  order       Int
  // Dimensiones declaradas por el cliente al publicar: el binario nunca pasa por el backend,
  // así que nadie más las conoce. Nulas para audio/texto (no tienen relación de aspecto).
  width       Int?
  height      Int?

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  // `Restrict`: un archivo usado en una publicación no se puede borrar (ni por borrado de
  // carpeta) — la publicación se quedaría sin medio. Ver docs/DATA-MODEL.md.
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([postId, fileAssetId])
  @@index([postId, order])
  @@index([fileAssetId])
  @@map("post_media")
}
